# ---------------------------------------------------------------------------
# AION Growth Funnel — environment configuration
#
# Copy to `.env.local` and fill in the values you have. Nothing here is
# required to run `npm run dev` and click through the funnel; the lead endpoint
# reports an honest "unavailable" state until durable storage is configured.
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server.
# Variables WITH it are inlined into the browser bundle — put nothing secret there.
# ---------------------------------------------------------------------------


# === Durable lead storage (required to accept leads) =======================
# Pick one driver. Without one, /api/leads returns 503 "not_configured" rather
# than pretending a submission was saved.
#
#   postgres — required for serverless deployments (Vercel, Lambda, Cloud Run).
#   sqlite   — fine for a single long-running Node process or local development.
LEAD_STORE_DRIVER=postgres

# Postgres connection string. Neon, Supabase, RDS, or your own server.
DATABASE_URL=postgresql://user:password@host:5432/aion?sslmode=require

# SQLite file path. Only used when LEAD_STORE_DRIVER=sqlite.
# LEAD_STORE_SQLITE_PATH=./data/leads.sqlite


# === GoHighLevel integration ===============================================
# Mode is explicit and never switches automatically after a failure.
#   api     — this server creates/updates the contact, fields, tags,
#             opportunity and note.
#   webhook — this server posts a versioned event to a GHL inbound workflow
#             webhook, and that workflow owns every CRM write.
#   hybrid  — (preferred) API owns the CRM records; after they succeed, an
#             event carrying the resulting GHL ids is posted to the workflow
#             for notifications and follow-up. The workflow must resolve the
#             existing contact, not create one.
GHL_INTEGRATION_MODE=hybrid

# Location-scoped Private Integration token (api / hybrid modes).
# Keep this server-side. See docs/ghl-integration.md for required scopes.
GHL_ACCESS_TOKEN=

# The GoHighLevel sub-account (location) id (api / hybrid modes).
GHL_LOCATION_ID=

# Opportunity pipeline. Resolve these ids in your own location — do not guess.
# If GHL_PIPELINE_ID is unset, no opportunity is created and the rest still runs.
GHL_PIPELINE_ID=
GHL_NEW_ASSESSMENT_STAGE_ID=

# Optional: the AION user new opportunities and notes are attributed to.
GHL_ASSIGNED_USER_ID=

# Inbound workflow webhook URL (webhook / hybrid modes).
# Created inside GoHighLevel: Automation > Workflows > Inbound Webhook trigger.
GHL_INBOUND_WEBHOOK_URL=

# Shared secret for INBOUND callbacks from GoHighLevel to this app, and sent as
# X-AION-Signature on outbound workflow events. Generate a long random value.
# Note: this is NOT how marketplace webhooks are verified — those use the
# platform's Ed25519 signature. See docs/ghl-integration.md.
GHL_CALLBACK_SECRET=

# Maps AION's internal field names to YOUR GoHighLevel custom-field ids.
# Fields you omit are simply not sent; no id is ever invented.
# Full list of valid keys: docs/ghl-field-mapping.md
# Keep the single quotes: they stop a shell-sourced .env from stripping the
# inner double quotes and turning this into invalid JSON.
GHL_CUSTOM_FIELD_MAP_JSON='{"business_category":"","primary_bottleneck":"","inquiry_channels":"","current_follow_up":"","desired_outcome":"","content_production_interest":"","start_timeframe":"","recommended_service":"","submission_id":"","submitted_at":"","utm_source":"","utm_medium":"","utm_campaign":"","utm_content":"","utm_term":"","landing_page":"","referrer":"","marketing_consent":"","marketing_consent_at":"","consent_copy_version":""}'

# API base URL and version. `v3` is HighLevel's current version; the legacy
# date versions (e.g. 2021-07-28) are still supported. One value is used for
# every call so versions are never mixed. Confirm against the version selector
# at https://marketplace.gohighlevel.com/docs/ before changing this.
# GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=v3

# Override only if HighLevel rotates its published webhook signing key.
# GHL_MARKETPLACE_PUBLIC_KEY=


# === Generic outbound webhook (optional, independent of GoHighLevel) =======
# A second destination for the same versioned event — Zapier, Make, an internal
# service. Signed with HMAC-SHA256 in the X-AION-Signature header when a secret
# is set.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=


# === Delivery worker =======================================================
# Shared secret protecting /api/jobs/process-deliveries. Without it, that
# endpoint refuses to run rather than being publicly triggerable.
DELIVERY_WORKER_SECRET=

# Bounded, awaited delivery attempt inside the submission request. On failure
# the record stays in the outbox for the worker. Set to false if you would
# rather keep the response as fast as possible.
# DELIVERY_INLINE=true
# DELIVERY_INLINE_BUDGET_MS=6000

# Retry ceiling before a submission is flagged for an operator.
# DELIVERY_MAX_ATTEMPTS=8
# DELIVERY_WORKER_BATCH=10
# INTEGRATION_HTTP_TIMEOUT_MS=10000


# === Abuse controls ========================================================
# Salt for hashing client IPs. Raw addresses are never stored. Set a random
# value in production so hashes are not comparable across deployments.
LEAD_IP_HASH_SALT=
# LEAD_MAX_PER_IP_PER_HOUR=8


# === Public values (visible in the browser) ================================
# Booking calendar link shown on the confirmation screen. If unset, the screen
# honestly says we'll reach out instead of inventing a calendar URL.
# A click on this link is tracked as a click, never as a confirmed booking.
NEXT_PUBLIC_BOOKING_URL=

# Fallback contact address shown when a submission cannot be accepted.
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical site URL, used for metadata, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://aionsystems.example

# Server-side overrides for the two values above. When set, these win, so the
# booking link and contact address can change without a rebuild.
# BOOKING_URL=
# CONTACT_EMAIL=
