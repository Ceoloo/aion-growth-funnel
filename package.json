    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.25",
    "playwright": "1.56.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
